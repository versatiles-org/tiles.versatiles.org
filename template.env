# tiles.versatiles.org Configuration
# Copy this file to .env and fill in the values

# Domain name
DOMAIN_NAME=tiles.versatiles.org

# RAM disk size for nginx cache (in GB)
RAM_DISK_GB=4

# E-mail address for the Let's Encrypt account. Must be a real address: setup
# refuses the placeholder. (Let's Encrypt no longer sends expiry warnings to it.)
EMAIL=name@example.org

# Where the .versatiles tile data comes from. It is downloaded from there with
# aria2c, and the tile server reads from there directly while a file is still
# being updated locally — and permanently for the high zoom levels of satellite.
# The default is the storage bucket itself, which is the right place for this
# kind of machine access. (https://download.versatiles.org serves the same files
# through the download website's Cloudflare Worker.)
# Optional; defaults to https://cdn.versatiles.cloud
# CDN_BASE_URL=https://cdn.versatiles.cloud

# Directory holding the downloaded .versatiles tile data — by far the largest
# volume (hundreds of GB). Point this at another filesystem / mount if the
# default location is too small. May be an absolute path. The directory is
# created and chowned to 1001:1001 by bin/deploy/ensure.sh.
# Optional; defaults to ./volumes/tiles
# TILES_DIR=/mnt/bigdisk/tiles
