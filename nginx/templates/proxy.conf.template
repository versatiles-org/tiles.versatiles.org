proxy_cache_path /data/nginx/cache levels=1:2 keys_zone=STATIC:10m inactive=24h max_size=${CACHE_MAX_SIZE_MB}m;

map $http_accept_encoding $accept_encoding {
   default "";
   "~*gzip" "gzip";
   "~*br" "${accept_encoding} br";
}

map $status $loggable {
   ~^[2] 0;
   499 0;
   default 1;
}

map $status $successful {
   ~^[2] 1;
   default 0;
}

# Browser cache policy, by response status.
#
# The tile backend sends `Cache-Control: max-age=2419200` (28 days) on every
# successful response. That is far too long here: after a data or frontend update
# a client would keep its old copy for weeks. So the backend's header is stripped
# (proxy_hide_header in `location /`) and replaced by the value below — one
# policy for everything, tiles and static files (HTML, JSON, fonts, sprites)
# alike:
#
#   2xx, 3xx  6 hours. Bounds how long stale data can linger in a browser after
#             an update.
#   404       5 minutes. A missing tile is a normal answer — map clients ask for
#             tiles beyond a dataset's coverage or zoom range all the time — so it
#             is cacheable. But only briefly: while the tile server reloads its
#             config, a changed tile source is gone for a moment and answers 404
#             too, and that must not stick in browsers for hours.
#   other     never. A 429, 500 or 502 describes a moment, not the resource; a
#             cached error would outlive the problem that caused it.
map $status $browser_cache_control {
   ~^[23]  "public, max-age=21600, no-transform";
   404     "public, max-age=300";
   default "no-store";
}

# Rate-limited requests (429, see limit_req below) tell the client when to come
# back. The limit is per second, so one second is enough for the bucket to drain
# a good part of its burst. Empty for every other status — nginx sends no header
# for an empty value.
map $status $retry_after {
   429     1;
   default "";
}

upstream versatiles_backend {
   server versatiles:8080;
   keepalive 16;
}

server {
   listen 80;
   listen [::]:80;
   server_name ${DOMAIN_NAME};
   server_tokens off;

   location /.well-known/acme-challenge/ {
      root /var/www/certbot;
   }

   location / {
      return 301 https://${DOMAIN_NAME}$request_uri;
   }
}

server {
   listen 443 ssl;
   listen [::]:443 ssl;
   http2 on;

   server_name ${DOMAIN_NAME};
   server_tokens off;

   ssl_certificate /etc/nginx/ssl/live/${DOMAIN_NAME}/fullchain.pem;
   ssl_certificate_key /etc/nginx/ssl/live/${DOMAIN_NAME}/privkey.pem;
   ssl_trusted_certificate /etc/nginx/ssl/live/${DOMAIN_NAME}/chain.pem;
   ssl_protocols TLSv1.2 TLSv1.3;
   ssl_ciphers 'EECDH+AESGCM:EDH+AESGCM';
   ssl_session_cache shared:SSL:10m;
   # OCSP stapling removed: Let's Encrypt no longer includes an OCSP responder
   # URL in issued certificates, so these directives were ignored and only
   # produced "ssl_stapling ignored" warnings on every reload.
   resolver 8.8.8.8 8.8.4.4 valid=300s;
   resolver_timeout 5s;

   proxy_cache_key "$uri,$is_args,$args,$accept_encoding";

   etag off;
   access_log /var/log/nginx/access.tsv.gz anonymized gzip if=$loggable;
   access_log /var/log/nginx/referer_stats.tsv.gz referer_stats gzip if=$successful;
   error_log  /var/log/nginx/error.log;

   autoindex off;
   charset utf-8;

   # Security headers
   add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
   add_header X-Content-Type-Options "nosniff" always;
   add_header Referrer-Policy "strict-origin-when-cross-origin" always;

   # Browser cache policy by response status (see $browser_cache_control map).
   # `always` is needed so that error responses get their explicit `no-store`.
   # The backend's 28-day Cache-Control is stripped in `location /` below so
   # only this value reaches clients. Keep this with the other server-level
   # add_headers: adding an add_header inside any location would silently drop
   # all of these inherited headers (HSTS, CORS, etc.) for that location.
   add_header Cache-Control $browser_cache_control always;

   # Only set on 429 responses (see $retry_after map).
   add_header Retry-After $retry_after always;

   # CORS headers
   add_header 'Access-Control-Allow-Origin' '*' always;
   add_header 'Access-Control-Allow-Methods' 'GET, HEAD, OPTIONS' always;
   add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-None-Match,If-Modified-Since,Cache-Control,Content-Type,Range,Accept-Encoding' always;
   add_header 'Access-Control-Expose-Headers' 'Content-Length,Content-Range,Etag,Last-Modified,Content-Encoding,Retry-After' always;

   location /.well-known/acme-challenge/ {
      root /var/www/certbot;
   }

	# redirect legacy paths
	#
	# Every target below must be a path the frontend actually serves — a redirect
	# to a 404 is worse than a plain 404. Current layout of the frontend bundle:
	#   /assets/lib/maplibre-gl/…   MapLibre GL JS
	#   /assets/glyphs/…            fonts ({fontstack}/{range}.pbf, index.json)
	#   /assets/sprites/…           sprite sheets (index.json lists them)
	#   /assets/styles/…            styles

	location /editor {
		return 301 https://versatiles.org/editor;
	}

	location ~ ^/maplibre/(.*)$ {
		return 301 /assets/lib/maplibre-gl/$1;
	}

	location ~ ^/assets/maplibre/(.*)$ {
		return 301 /assets/lib/maplibre-gl/$1;
	}

	# The font list. Exact matches, so they win over the /assets/fonts/ regex below.
	location = /fonts.json {
		return 301 /assets/glyphs/index.json;
	}

	location = /assets/fonts.json {
		return 301 /assets/glyphs/index.json;
	}

	location = /assets/fonts/fonts.json {
		return 301 /assets/glyphs/index.json;
	}

	# Fonts moved from "fonts" to "glyphs".
	location ~ ^/fonts/(.*)$ {
		return 301 /assets/glyphs/$1;
	}

	location ~ ^/assets/fonts/(.*)$ {
		return 301 /assets/glyphs/$1;
	}

	location = /sprites.json {
		return 301 /assets/sprites/index.json;
	}

	# Only the missing /assets prefix is added here. The v5 sprite sheets
	# (`basics`, `markers`) are deliberately not mapped to their v6 successors
	# (`base`, `extras`, `icons`): icon ids were renamed, so a redirect would hand
	# old styles a sheet in which some of their icons do not exist.
	location ~ ^/(styles|sprites)/(.*)$ {
		return 301 /assets/$1/$2;
	}

	# versatiles-style v6 renamed four palettes and inverted the satellite/terrain
	# overlay naming. v6 still ships the v5 names as aliases, so serving them would
	# quietly hand clients a different-looking style; a 301 instead names the file
	# that now holds what they asked for.
	#
	# Not redirected, deliberately:
	#   - satellite/style.json, terrain/style.json — still valid v6 URLs, but their
	#     contents changed (bare imagery; the OSM overlay moved to overlay.json).
	#     Redirecting them would break the v6 meaning of a name that still exists.
	#   - empty/style.json — changed (it now paints a background) but has no
	#     successor name to point at.

	location ~ ^/assets/styles/eclipse(-terrain)?/(.*)$ {
		return 301 /assets/styles/colorful-dark$1/$2$is_args$args;
	}

	location ~ ^/assets/styles/graybeard(-terrain)?/(.*)$ {
		return 301 /assets/styles/gray$1/$2$is_args$args;
	}

	location ~ ^/assets/styles/shadow(-terrain)?/(.*)$ {
		return 301 /assets/styles/gray-dark$1/$2$is_args$args;
	}

	# neutrino has no exact successor — upstream maps it to `muted` as the closest
	# match, which is a considerably fuller style than v5's neutrino.
	location ~ ^/assets/styles/neutrino(-terrain)?/(.*)$ {
		return 301 /assets/styles/muted$1/$2$is_args$args;
	}

	# v5 `nooverlay` (imagery only) is what v6 publishes as plain `style.json`.
	location ~ ^/assets/styles/(satellite|terrain)/nooverlay\.json$ {
		return 301 /assets/styles/$1/style.json$is_args$args;
	}

   location / {
      limit_req zone=tiles burst=1000 nodelay;
      proxy_pass            http://versatiles_backend;
      proxy_set_header      Host $host;
      proxy_http_version    1.1;
      proxy_set_header      Connection "";
      proxy_hide_header     Cache-Control;
      # Set by this server block already (add_header above); versatiles 5 sends
      # it too, which would put the header on every response twice.
      proxy_hide_header     X-Content-Type-Options;
      proxy_hide_header     Access-Control-Allow-Origin;
      proxy_hide_header     Access-Control-Allow-Methods;
      proxy_hide_header     Access-Control-Allow-Headers;
      proxy_hide_header     Access-Control-Expose-Headers;
      proxy_buffering       on;
      proxy_cache           STATIC;
      proxy_cache_valid     200 1d;
      # Missing tiles are requested constantly; keep them off the tile server,
      # but only briefly (same reasoning and lifetime as in the browser policy).
      proxy_cache_valid     404 5m;
      # Refresh an expired cache entry with a conditional request (If-None-Match)
      # instead of fetching it again in full. Needs the ETag that versatiles
      # sends from 5.0 on; without one nginx simply fetches as before.
      proxy_cache_revalidate on;
      proxy_cache_lock      on;
      proxy_cache_lock_timeout 5s;
      proxy_cache_use_stale error timeout invalid_header updating http_500 http_502 http_503 http_504;
   }
}